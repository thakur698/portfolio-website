rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public read for public media and resumes
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny for sensitive uploads
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
