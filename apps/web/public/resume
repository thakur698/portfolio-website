      color: #111827;
      line-height: 1.3;
      font-size: 9.1pt;
      background: #f1f5f9;
      padding: 20px;
    }
    .toolbar {
      max-width: 820px;
      margin: 0 auto 15px auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #0f172a;
      color: #f8fafc;
      padding: 10px 16px;
      border-radius: 8px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    .toolbar span {
      font-size: 9pt;
      color: #94a3b8;
    }
    .print-btn {
      background: #2563eb;
      color: #ffffff;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 9pt;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }
    .print-btn:hover {
      background: #1d4ed8;
    }
    .page-container {
      max-width: 820px;
      margin: 0 auto;
      background: #ffffff;
      padding: 24px 28px;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      border-radius: 4px;
      outline: none;
    }
    header {
      text-align: center;
      border-bottom: 1.5px solid #0f172a;
      padding-bottom: 4px;
      margin-bottom: 6px;
    }
    h1 {
      font-size: 16.5pt;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: #0f172a;
      text-transform: uppercase;
      margin-bottom: 2px;
    }
    .contact-line {
      font-size: 8.6pt;
      color: #334155;
    }
    .contact-line a {
      color: #0369a1;
      text-decoration: none;
    }
    section {
      margin-bottom: 5px;
    }
    h2 {
      font-size: 9.5pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #0f172a;
      border-bottom: 1px solid #cbd5e1;
      padding-bottom: 2px;
      margin-bottom: 3px;
    }
    p {
      margin-bottom: 2.5px;
      text-align: justify;
    }
    ul {
      margin-left: 15px;
      margin-bottom: 2.5px;
    }
    li {
      margin-bottom: 1.5px;
    }
    .item-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-weight: 700;
      font-size: 9.1pt;
      color: #0f172a;
    }
    .item-sub {
      display: flex;
      justify-content: space-between;
      font-style: italic;
      font-size: 8.4pt;
      color: #475569;
      margin-bottom: 2px;
    }
    .skills-row {
      margin-bottom: 2px;
    }
    .skills-row strong {
      color: #0f172a;
    }

    /* Print Setup */
    @media print {
      body {
        background: #ffffff;
        padding: 0;
      }
      .toolbar {
        display: none !important;
      }
      .page-container {
        box-shadow: none;
        padding: 0;
        max-width: 100%;
      }
    }
  </style>
</head>
