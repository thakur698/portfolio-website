{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/apps/web/index.html" },
    { "source": "/index.html", "destination": "/apps/web/index.html" },
    { "source": "/projects", "destination": "/apps/web/projects.html" },
    { "source": "/projects.html", "destination": "/apps/web/projects.html" },
    { "source": "/resume", "destination": "/apps/web/resume.html" },
    { "source": "/resume.html", "destination": "/apps/web/resume.html" },
    { "source": "/(.*)", "destination": "/apps/web/$1" }
  ]
}
